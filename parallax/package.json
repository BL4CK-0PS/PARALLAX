{
  "name": "parallax",
  "version": "1.0.0",
  "description": "PARALLAX - Autonomous Digital Reality Intelligence for Browser Workflows",
  "type": "module",
  "main": "src/core/types.ts",
  "scripts": {
    "start": "node --experimental-strip-types scripts/start-all.ts",
    "dev": "node --experimental-strip-types scripts/start-all.ts",
    "test": "node --experimental-strip-types --test tests/unit/*.test.ts tests/security/*.test.ts tests/integration/*.test.ts",
    "test:security": "node --experimental-strip-types --test tests/security/*.test.ts",
    "demo:server": "node --experimental-strip-types demo-app/server/server.ts",
    "demo:ui": "node --experimental-strip-types ui/server.ts",
    "demo:run": "node --experimental-strip-types scripts/run-demo.ts",
    "eval": "node --experimental-strip-types scripts/eval.ts",
    "test:e2e": "node --experimental-strip-types --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:all": "npm test && npm run test:e2e",
    "typecheck": "tsc --noEmit -p .",
    "browsers:install": "playwright install chromium"
  },
  "keywords": [
    "browser-agent",
    "digital-forensics",
    "playwright",
    "autonomous-agents",
    "deterministic-policy",
    "fail-closed"
  ],
  "author": "BL4CK_0P$",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "playwright": "^1.65.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3"
  }
}
